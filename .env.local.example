# Firebase Environment Variables
# Copy this file to .env.local and fill in your Firebase project credentials.
# Get these from: Firebase Console → Project Settings → General → Your apps → SDK setup and configuration

# API URL for the backend service used by the frontend.
# For local development use http://localhost:5000
# For Vercel production deployments set this in Vercel's Environment Variables.
VITE_API_URL=http://localhost:5000

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
